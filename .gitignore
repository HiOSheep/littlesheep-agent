# Dependencies
node_modules/
.pnpm-store/
node_modules.link-damaged-*/
.local/node_modules-recovery-backup-*/

# Build output
dist/
packages/*/dist/
packages/channels/*/dist/
packages/app/out/
packages/app/runtime/
packages/app/.release-staging*/
packages/app/.release-staging/
*.tsbuildinfo
build/
release/

# Test
coverage/
.vitest-cache/
.vitest/

# Test scratch. Harness cache suites used to create these with mkdtemp() under
# process.cwd(); they now use the OS temp dir, but a checkout made before that
# change — or any interrupted run that cannot reach its afterEach — still leaves
# this shape behind. The rules are shape-specific on purpose: the same names exist
# as real sources (packages/harness/src/cache-observation-store.ts), which stay tracked.
cache-scope-matrix-*/
cache-observation-store-*/

# Vite bundles a TypeScript config next to the config file and unlinks the bundle
# fire-and-forget (vite 5 `loadConfigFromBundledFile`), so a killed vitest or
# electron-vite process leaves it beside the real config. Nothing but the bundler
# ever writes these names.
vitest.config.ts.timestamp-*.mjs
electron.vite.config.*.mjs

# User data (runtime)
.littlesheep/
sessions/
memory/*.md.bak

# IDE
.vscode/
.idea/
*.swp
*.swo

# Caches and temporary files
.codex_tmp/
.cache/
.vite/
.turbo/
.eslintcache
tmp/
temp/
*.tmp
*.temp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# One-off local diagnostics
scripts/debug-sidebar-corner.mjs

# Renderer bundle attribution report (regenerate with scripts/report-renderer-chunks.mjs)
renderer-module-report.json

# Env
.env
.env.local
.env.*.local

# Generated PDFs
*.pdf

# Cold-start measurement scratch ledger (written when no --label is given).
docs/reference/cold-start-baseline/desktop-cold-start-unlabeled.json

# Node/V8 compile cache some tooling writes next to the package (regenerable, never tracked).
.wb-tmp/
