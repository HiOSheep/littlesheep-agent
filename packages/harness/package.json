{
  "name": "@littlesheep/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@littlesheep/context": "workspace:*",
    "@littlesheep/types": "workspace:*",
    "@littlesheep/session": "workspace:*",
    "@littlesheep/memory-core": "workspace:*",
    "@littlesheep/memory-tree": "workspace:*",
    "@littlesheep/config": "workspace:*",
    "@littlesheep/tools": "workspace:*",
    "@littlesheep/prompt": "workspace:*",
    "@littlesheep/classifier": "workspace:*",
    "@littlesheep/llm": "workspace:*",
    "@littlesheep/branding": "workspace:*",
    "@littlesheep/safety": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  }
}
