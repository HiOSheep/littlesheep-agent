{
  "name": "@littlesheep/context",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "@littlesheep/config": "workspace:*",
    "@littlesheep/llm": "workspace:*",
    "@littlesheep/safety": "workspace:*",
    "@littlesheep/types": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  }
}
