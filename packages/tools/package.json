{
  "name": "@littlesheep/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@littlesheep/config": "workspace:*",
    "@littlesheep/experience": "workspace:*",
    "@littlesheep/types": "workspace:*",
    "@littlesheep/memory-core": "workspace:*",
    "@littlesheep/session": "workspace:*",
    "@littlesheep/vector": "workspace:*",
    "zod": "^3.23.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  }
}
