{
    "name": "@littlesheep/safety",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./verified-asset": {
            "types": "./dist/verified-asset.d.ts",
            "import": "./dist/verified-asset.js"
        }
    },
    "scripts": {
        "clean": "rimraf dist *.tsbuildinfo",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@littlesheep/types": "workspace:*"
    }
}
