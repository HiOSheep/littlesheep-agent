{
  "name": "littlesheep",
  "version": "0.1.0",
  "private": true,
  "description": "LittleSheep 是一个本地部署、索引优先记忆、硬控制流驱动的桌面 Agent 工作台。",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0",
  "bin": {
    "littlesheep": "./packages/cli/dist/bin.js"
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm run build:app",
    "build:app": "node scripts/ensure-app-build.mjs --build",
    "ensure:app-build": "node scripts/ensure-app-build.mjs --ensure",
    "assert:app-build": "node scripts/ensure-app-build.mjs --assert",
    "ensure:workspace-build": "node scripts/ensure-workspace-artifacts.mjs",
    "assert:workspace-build": "node scripts/ensure-workspace-artifacts.mjs --assert",
    "check:repo": "node scripts/check-repository-hygiene.mjs && node scripts/sync-typescript-projects.mjs --check",
    "sync:tsconfig": "node scripts/sync-typescript-projects.mjs",
    "start": "node packages/cli/dist/bin.js",
    "test": "vitest run",
    "test:changed": "node scripts/run-affected-verification.mjs --tests-only",
    "test:fast": "pnpm run test:core-eval",
    "test:full": "vitest run",
    "test:core-eval": "vitest run test/core-agent-contracts.test.ts packages/harness/src/e2e.test.ts packages/harness/src/stages/decide.test.ts packages/harness/src/stages/execute.test.ts packages/harness/src/stages/verify.test.ts packages/harness/src/stages/memory-stages.test.ts packages/app/src/shared/history-activity.test.ts",
    "test:watch": "vitest",
    "clean": "pnpm -r run clean && rimraf node_modules",
    "typecheck": "tsc -b tsconfig.workspace.json --pretty false",
    "typecheck:changed": "node scripts/run-affected-verification.mjs --typecheck-only",
    "measure:verification": "node scripts/measure-verification-baseline.mjs",
    "verify:changed": "node scripts/run-verification-gate.mjs --gate=changed",
    "verify:core": "node scripts/run-verification-gate.mjs --gate=core",
    "verify:full": "node scripts/run-verification-gate.mjs --gate=full",
    "verify:provider": "node scripts/verify-provider-smoke.mjs",
    "verify:electron-continuity": "pnpm run ensure:app-build && node scripts/verify-electron-runtime-continuity.mjs",
    "verify:electron-deepseek-reply-continuity": "pnpm run ensure:app-build && node scripts/verify-electron-deepseek-reply-continuity.mjs",
    "verify:electron-deepseek-compaction-continuity": "pnpm run ensure:app-build && node scripts/verify-electron-deepseek-compaction-continuity.mjs",
    "verify:electron-deepseek-single-tool": "pnpm run ensure:app-build && node scripts/verify-electron-deepseek-single-tool.mjs",
    "verify:electron-deepseek-autonomous-read": "pnpm run ensure:app-build && node scripts/verify-electron-deepseek-single-tool.mjs --autonomous-read",
    "verify:electron-deepseek-autonomous-read-matrix": "pnpm run ensure:app-build && node scripts/verify-electron-deepseek-single-tool.mjs --autonomous-read --tool=glob && node scripts/verify-electron-deepseek-single-tool.mjs --autonomous-read --tool=grep && node scripts/verify-electron-deepseek-single-tool.mjs --autonomous-read --tool=read",
    "verify:electron-deepseek-tool-loop": "pnpm run verify:electron-deepseek-autonomous-read",
    "verify:electron-deepseek-background-task": "pnpm run ensure:app-build && node scripts/verify-electron-deepseek-background-task.mjs",
    "verify:electron-deepseek-parallel-load": "pnpm run ensure:app-build && node scripts/verify-electron-deepseek-parallel-load.mjs",
    "verify:electron-deepseek-sustained-load": "pnpm run ensure:app-build && node scripts/verify-electron-deepseek-sustained-load.mjs",
    "verify:electron-deepseek-hours": "pnpm run ensure:app-build && node scripts/verify-electron-deepseek-sustained-load.mjs --mode=formal",
    "verify:deepseek-v4-tool-tokenizer": "pnpm run ensure:workspace-build -- --package=@littlesheep/context --package=@littlesheep/branding && pnpm run ensure:app-build && node scripts/run-verified-electron.mjs scripts/verify-deepseek-v4-tool-tokenizer.mjs",
    "verify:memory-v3-provider": "pnpm run ensure:workspace-build -- --package=@littlesheep/runner --package=@littlesheep/embedding --package=@littlesheep/branding && pnpm run ensure:app-build && node scripts/run-verified-electron.mjs scripts/verify-memory-v3-provider.mjs",
    "verify:memory-v3-soak": "pnpm run ensure:workspace-build -- --package=@littlesheep/memory-tree && node scripts/verify-memory-v3-soak.mjs",
    "verify:memory-v3-bge-soak": "pnpm run ensure:workspace-build -- --package=@littlesheep/embedding --package=@littlesheep/branding && node scripts/verify-memory-v3-soak.mjs --embedding=local --embedding-model=bge-small-zh-v1.5 --atoms=256 --runs=128 --feedback-events=128 --max-rss-mib=512",
    "verify:memory-v3-relevance": "pnpm run ensure:workspace-build -- --package=@littlesheep/embedding --package=@littlesheep/branding && node scripts/verify-memory-v3-relevance.mjs",
    "verify:memory-v3-evolution": "pnpm run ensure:workspace-build -- --package=@littlesheep/memory-tree --package=@littlesheep/embedding --package=@littlesheep/branding && node scripts/verify-memory-v3-evolution.mjs",
    "verify:memory-v3-intent-routing": "pnpm run ensure:workspace-build -- --package=@littlesheep/memory-tree --package=@littlesheep/branding && node scripts/verify-memory-v3-intent-routing.mjs",
    "verify:memory-v3-compaction-continuity": "pnpm run ensure:workspace-build -- --package=@littlesheep/memory-tree --package=@littlesheep/embedding --package=@littlesheep/branding && node scripts/verify-memory-v3-compaction-continuity.mjs",
    "verify:memory-v3-relationship-routing": "pnpm run ensure:workspace-build -- --package=@littlesheep/memory-tree && node scripts/verify-memory-v3-relationship-routing.mjs",
    "verify:memory-v3-epistemic-writes": "pnpm exec vitest run packages/harness/src/stages/memory-epistemic-policy.test.ts packages/harness/src/stages/memory-stages.test.ts packages/runner/src/memory-v3.integration.test.ts",
    "verify:memory-v3-atom-reconciliation": "pnpm run ensure:workspace-build -- --package=@littlesheep/memory-tree && pnpm exec vitest run packages/harness/src/stages/memory-epistemic-policy.test.ts packages/harness/src/stages/memory-stages.test.ts packages/memory-tree/src/memory-repository/v3-write-graph-projection.test.ts && node scripts/verify-memory-v3-atom-reconciliation.mjs",
    "verify:memory-v3-taskbook-refinement": "pnpm run ensure:workspace-build -- --package=@littlesheep/runner && node scripts/verify-memory-v3-taskbook-refinement.mjs",
    "verify:memory-v3-activation": "pnpm exec vitest run packages/types/src/activation.test.ts packages/types/src/activation-projection.test.ts packages/memory-tree/src/v3/catalog.test.ts packages/memory-tree/src/v3/contracts-priority.test.ts packages/memory-tree/src/memory-repository/v3-retrieval-activation.test.ts packages/memory-tree/src/memory-repository/v3-backend.test.ts packages/session/src/cache-activation-store.test.ts packages/runner/src/session-summary-activation.test.ts packages/runner/src/memory-v3.integration.test.ts packages/app/src/main/memory-files.test.ts packages/app/src/main/memory-files-api.test.ts",
    "verify:memory-v3-workload-observability": "pnpm exec vitest run packages/runner/src/runtime-resource-observation.test.ts packages/runner/src/memory-workload-observability.test.ts packages/runner/src/execution-log.test.ts && pnpm --filter @littlesheep/runner run typecheck",
    "report:memory-v3-workload": "pnpm run ensure:workspace-build -- --package=@littlesheep/runner && node scripts/report-memory-v3-workload.mjs",
    "verify:memory-v3-readiness": "pnpm run ensure:workspace-build -- --package=@littlesheep/runner && node scripts/verify-memory-v3-migration-readiness.mjs",
    "benchmark:embedding": "pnpm run ensure:workspace-build -- --package=@littlesheep/embedding && node scripts/benchmark-local-embedding.mjs",
    "verify:app-recovery": "node scripts/verify-app-recovery-sources.mjs",
    "verify:workspace-performance": "pnpm run assert:app-build && node scripts/verify-workspace-performance.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  }
}
