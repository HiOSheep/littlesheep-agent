{
  "name": "littlesheep",
  "version": "0.1.0",
  "private": true,
  "description": "LittleSheep 是一个本地部署、索引优先记忆、硬控制流驱动的桌面 Agent 工作台。",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0",
  "bin": {
    "littlesheep": "./packages/cli/dist/bin.js"
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm --filter @littlesheep/app run build",
    "check:repo": "node scripts/check-repository-hygiene.mjs && node scripts/sync-typescript-projects.mjs --check",
    "sync:tsconfig": "node scripts/sync-typescript-projects.mjs",
    "start": "node packages/cli/dist/bin.js",
    "test": "vitest run",
    "test:changed": "node scripts/run-affected-verification.mjs --tests-only",
    "test:fast": "pnpm run test:core-eval",
    "test:full": "vitest run",
    "test:core-eval": "vitest run test/core-agent-contracts.test.ts packages/harness/src/e2e.test.ts packages/harness/src/stages/decide.test.ts packages/harness/src/stages/execute.test.ts packages/harness/src/stages/verify.test.ts packages/harness/src/stages/memory-stages.test.ts packages/app/src/shared/history-activity.test.ts",
    "test:watch": "vitest",
    "clean": "pnpm -r run clean && rimraf node_modules",
    "typecheck": "tsc -b tsconfig.workspace.json --pretty false",
    "typecheck:changed": "node scripts/run-affected-verification.mjs --typecheck-only",
    "verify:changed": "pnpm run check:repo && node scripts/run-affected-verification.mjs",
    "verify:core": "pnpm run check:repo && pnpm run typecheck && pnpm run test:core-eval",
    "verify:full": "pnpm run check:repo && pnpm run test && pnpm run typecheck && pnpm run build && pnpm run verify:app-recovery",
    "verify:provider": "node scripts/verify-provider-smoke.mjs",
    "verify:electron-continuity": "pnpm --filter @littlesheep/app... run build && node scripts/verify-electron-runtime-continuity.mjs",
    "verify:memory-v3-provider": "pnpm --filter @littlesheep/runner... --filter @littlesheep/embedding... --filter @littlesheep/branding run build && pnpm --filter @littlesheep/app exec electron ../../scripts/verify-memory-v3-provider.mjs",
    "verify:memory-v3-soak": "pnpm --filter @littlesheep/memory-tree... run build && node scripts/verify-memory-v3-soak.mjs",
    "verify:memory-v3-bge-soak": "pnpm --filter @littlesheep/embedding... --filter @littlesheep/branding run build && node scripts/verify-memory-v3-soak.mjs --embedding=local --embedding-model=bge-small-zh-v1.5 --atoms=256 --runs=128 --feedback-events=128 --max-rss-mib=512",
    "verify:memory-v3-relevance": "pnpm --filter @littlesheep/embedding... --filter @littlesheep/branding run build && node scripts/verify-memory-v3-relevance.mjs",
    "verify:memory-v3-evolution": "pnpm --filter @littlesheep/memory-tree... --filter @littlesheep/embedding... --filter @littlesheep/branding run build && node scripts/verify-memory-v3-evolution.mjs",
    "verify:memory-v3-intent-routing": "pnpm --filter @littlesheep/memory-tree... --filter @littlesheep/embedding... --filter @littlesheep/branding run build && node scripts/verify-memory-v3-intent-routing.mjs",
    "verify:memory-v3-compaction-continuity": "pnpm --filter @littlesheep/memory-tree... --filter @littlesheep/embedding... --filter @littlesheep/branding run build && node scripts/verify-memory-v3-compaction-continuity.mjs",
    "verify:memory-v3-relationship-routing": "pnpm --filter @littlesheep/memory-tree... run build && node scripts/verify-memory-v3-relationship-routing.mjs",
    "verify:memory-v3-epistemic-writes": "pnpm exec vitest run packages/harness/src/stages/memory-epistemic-policy.test.ts packages/harness/src/stages/memory-stages.test.ts packages/runner/src/memory-v3.integration.test.ts",
    "verify:memory-v3-atom-reconciliation": "pnpm --filter @littlesheep/memory-tree... run build && pnpm exec vitest run packages/harness/src/stages/memory-epistemic-policy.test.ts packages/harness/src/stages/memory-stages.test.ts packages/memory-tree/src/memory-repository/v3-write-graph-projection.test.ts && node scripts/verify-memory-v3-atom-reconciliation.mjs",
    "verify:memory-v3-taskbook-refinement": "pnpm --filter @littlesheep/runner... run build && node scripts/verify-memory-v3-taskbook-refinement.mjs",
    "verify:memory-v3-activation": "pnpm exec vitest run packages/types/src/activation.test.ts packages/types/src/activation-projection.test.ts packages/memory-tree/src/v3/catalog.test.ts packages/memory-tree/src/v3/contracts-priority.test.ts packages/memory-tree/src/memory-repository/v3-retrieval-activation.test.ts packages/memory-tree/src/memory-repository/v3-backend.test.ts packages/session/src/cache-activation-store.test.ts packages/runner/src/session-summary-activation.test.ts packages/runner/src/memory-v3.integration.test.ts packages/app/src/main/memory-files.test.ts packages/app/src/main/memory-files-api.test.ts",
    "verify:memory-v3-workload-observability": "pnpm exec vitest run packages/runner/src/runtime-resource-observation.test.ts packages/runner/src/memory-workload-observability.test.ts packages/runner/src/execution-log.test.ts && pnpm --filter @littlesheep/runner run typecheck",
    "report:memory-v3-workload": "pnpm --filter @littlesheep/runner... run build && node scripts/report-memory-v3-workload.mjs",
    "verify:memory-v3-readiness": "pnpm --filter @littlesheep/runner... run build && node scripts/verify-memory-v3-migration-readiness.mjs",
    "benchmark:embedding": "pnpm --filter @littlesheep/embedding run build && node scripts/benchmark-local-embedding.mjs",
    "verify:app-recovery": "node scripts/verify-app-recovery-sources.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  }
}
