{
  "name": "littlesheep",
  "version": "0.1.0",
  "private": true,
  "description": "LittleSheep 是一个本地部署、索引优先记忆、硬控制流驱动的桌面 Agent 工作台。",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0",
  "bin": {
    "littlesheep": "./packages/cli/dist/bin.js"
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm --filter @littlesheep/app run build",
    "check:repo": "node scripts/check-repository-hygiene.mjs && node scripts/sync-typescript-projects.mjs --check",
    "sync:tsconfig": "node scripts/sync-typescript-projects.mjs",
    "start": "node packages/cli/dist/bin.js",
    "test": "vitest run",
    "test:changed": "node scripts/run-affected-verification.mjs --tests-only",
    "test:fast": "pnpm run test:core-eval",
    "test:full": "vitest run",
    "test:core-eval": "vitest run test/core-agent-contracts.test.ts packages/harness/src/e2e.test.ts packages/harness/src/stages/decide.test.ts packages/harness/src/stages/execute.test.ts packages/harness/src/stages/verify.test.ts packages/harness/src/stages/memory-stages.test.ts packages/app/src/shared/history-activity.test.ts",
    "test:watch": "vitest",
    "clean": "pnpm -r run clean && rimraf node_modules",
    "typecheck": "tsc -b tsconfig.workspace.json --pretty false",
    "typecheck:changed": "node scripts/run-affected-verification.mjs --typecheck-only",
    "verify:changed": "pnpm run check:repo && node scripts/run-affected-verification.mjs",
    "verify:core": "pnpm run check:repo && pnpm run typecheck && pnpm run test:core-eval",
    "verify:full": "pnpm run check:repo && pnpm run test && pnpm run typecheck && pnpm run build && pnpm run verify:app-recovery",
    "verify:provider": "pnpm --filter @littlesheep/app exec electron ../../scripts/verify-provider-smoke.mjs",
    "verify:memory-v3-soak": "pnpm --filter @littlesheep/memory-tree... run build && node scripts/verify-memory-v3-soak.mjs",
    "verify:memory-v3-readiness": "pnpm --filter @littlesheep/embedding... run build && node scripts/verify-memory-v3-migration-readiness.mjs",
    "benchmark:embedding": "pnpm --filter @littlesheep/embedding run build && node scripts/benchmark-local-embedding.mjs",
    "verify:app-recovery": "node scripts/verify-app-recovery-sources.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  }
}
